{
  "schemaVersion": 1,
  "id": "seamless-gradient-glass",
  "version": "${version}",
  "name": "Seamless Gradient Glass",
  "description": "Connected glass with smooth transitions between neighboring dye colors.",
  "environment": "client",
  "entrypoints": {
    "client": ["com.ixce.gradientglass.GradientGlass"],
    "modmenu": ["com.ixce.gradientglass.config.ModMenuIntegration"]
  },
  "mixins": ["gradientglass.mixins.json"],
  "custom": {
    "sodium-extra:options": {
      "mixin.optimizations.beacon_beam_rendering": false
    }
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "yet_another_config_lib_v3": "*",
    "modmenu": "*"
  }
}
