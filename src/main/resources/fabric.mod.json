{
  "schemaVersion": 1,
  "id": "seamless-gradient-glass",
  "version": "${version}",
  "name": "Seamless Gradient Glass",
  "description": "Connected glass with smooth transitions between neighboring dye colors (Sodium 0.5 & legacy 1.19.4-1.20.4 edition).",
  "environment": "client",
  "entrypoints": { "client": ["com.ixce.gradientglass.GradientGlass"] },
  "mixins": ["gradientglass.client.mixins.json"],
  "custom": {
    "sodium-extra:options": {
      "mixin.optimizations.beacon_beam_rendering": false
    }
  },
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}
